config LIBINTERCEPT
	bool "intercept: boot-time init probe"
	default n
	help
		Loads a minimal intercept library during boot and prints a single
		message once initialization runs.

if LIBINTERCEPT

config LIBINTERCEPT_TRANSPORT_SOCKET
	bool "TCP transport probe"
	select LIBPOSIX_SOCKET
	default y
	help
		Enable a minimal TCP transport for validating guest-to-host
		connectivity from the intercept library.

config LIBINTERCEPT_REMOTE_IPV4
	string "Remote IPv4 address"
	depends on LIBINTERCEPT_TRANSPORT_SOCKET
	default "172.44.0.1"

config LIBINTERCEPT_REMOTE_PORT
	int "Remote TCP port"
	depends on LIBINTERCEPT_TRANSPORT_SOCKET
	range 1 65535
	default 9999

choice
	prompt "Server connection policy"
	depends on LIBINTERCEPT_TRANSPORT_SOCKET
	default LIBINTERCEPT_CONNECT_ON_FIRST_RPC
	help
		Select when the intercept transport should establish its TCP
		connection to the host syscall server.

config LIBINTERCEPT_CONNECT_ON_FIRST_RPC
	bool "Connect on first RPC"
	help
		Keep boot independent from server availability and connect only
		when the first intercepted RPC is issued.

config LIBINTERCEPT_CONNECT_BOOT_BEST_EFFORT
	bool "Best-effort connect during boot"
	help
		Attempt an end-to-end RPC probe during intercept boot
		initialization, but keep booting if the server is not reachable.
		Later RPCs will retry.

config LIBINTERCEPT_CONNECT_BOOT_REQUIRED
	bool "Require successful connect during boot"
	help
		Require an end-to-end RPC probe to succeed during intercept boot
		initialization. If the server is unavailable or does not answer
		the probe, intercept init fails.

endchoice

endif
